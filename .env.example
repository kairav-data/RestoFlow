# RestoFlow environment template. Copy to .env and fill in. NEVER commit .env.

# --- Database (PostgreSQL, e.g. Supabase) ---
# URL-encode special characters in the password ("@" becomes "%40").
# On serverless hosts use the pooled connection string and add ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require"

# --- Sessions (required, long random strings: openssl rand -base64 48) ---
SESSION_SECRET=""            # signs restaurant-staff and guest sessions
ADMIN_SESSION_SECRET=""      # signs platform-admin sessions
SETTINGS_ENCRYPTION_SECRET="" # encrypts the Google API key an admin saves in the portal

# --- Platform admin sign-in for /admin (required) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Guest SMS sign-in via Twilio (required in production) ---
# Without these, local development prints the one-time code in the server console and the sign-in sheet.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""                       # a Twilio number, or use TWILIO_MESSAGING_SERVICE_SID instead
# TWILIO_MESSAGING_SERVICE_SID=""
# DEFAULT_COUNTRY_CODE="+91"         # used when a guest types a 10-digit number

# --- AI (menu scan from photo, dish descriptions) ---
AI_PROVIDER="ollama"                 # "ollama" (free, open-source models) or "google" (Gemini)
# OLLAMA_BASE_URL="http://127.0.0.1:11434"   # on Vercel use "https://ollama.com" together with OLLAMA_API_KEY
# OLLAMA_API_KEY=""                 # create at ollama.com/settings/keys (hosted Ollama only)
# OLLAMA_MODEL="gemma4:31b-cloud"    # any vision-capable model, e.g. qwen2.5vl:7b or gemma3:4b
# GOOGLE_API_KEY=""                  # only when AI_PROVIDER=google (an admin can also save it in /admin)
# GEMINI_MODEL="gemini-3.8-flash"
