// Prisma client schema for RestoFlow.
//
// SOURCE OF TRUTH is db/schema.sql (partitioning, composite tenant-safe foreign keys, partial
// indexes and RLS cannot be expressed in Prisma). This file maps the same tables for a typed client.
// Relations are intentionally omitted: the database already enforces them with composite
// (restaurant_id, id) foreign keys. To generate relation fields run `npx prisma db pull` after
// applying db/schema.sql, then re-add the @@map names.
//
// RULE: every query on a restaurant-owned model MUST filter by restaurantId taken from the
// verified server session, never from the request body.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RestaurantStatus {
  pending
  active
  suspended
  closed

  @@map("restaurant_status")
}

enum StaffRole {
  owner
  manager
  staff
  kitchen

  @@map("staff_role")
}

enum AccountStatus {
  active
  disabled

  @@map("account_status")
}

enum SessionStatus {
  active
  closed

  @@map("session_status")
}

enum OrderStatus {
  new
  preparing
  ready
  served
  cancelled

  @@map("order_status")
}

enum OrderType {
  dine_in
  takeaway
  qr_online

  @@map("order_type")
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded

  @@map("payment_status")
}

enum PaymentMethod {
  upi
  card
  cash
  wallet

  @@map("payment_method")
}

enum DiscountType {
  percent
  flat

  @@map("discount_type")
}

model Restaurant {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique
  name        String
  tagline     String?
  cuisine     String?
  status      RestaurantStatus @default(active)
  currency    String           @default("INR") @db.Char(3)
  timezone    String           @default("Asia/Kolkata")
  logoUrl     String?          @map("logo_url")
  coverUrl    String?          @map("cover_url")
  phone       String?
  ratingAvg   Decimal          @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount Int              @default(0) @map("rating_count")
  description    String?
  address        String?
  location       String?
  operatingHours String? @map("operating_hours")
  settings    Json             @default("{}")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("restaurants")
}

model Branch {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  name         String
  address      String?
  city         String?
  phone        String?
  opensAt      DateTime? @map("opens_at") @db.Time
  closesAt     DateTime? @map("closes_at") @db.Time
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([restaurantId, name])
  @@map("branches")
}

model StaffUser {
  id           String        @id @default(uuid()) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  email        String
  passwordHash String        @map("password_hash")
  fullName     String        @map("full_name")
  role         StaffRole
  status       AccountStatus @default(active)
  branchId     String?       @map("branch_id") @db.Uuid
  lastLoginAt  DateTime?     @map("last_login_at") @db.Timestamptz
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([restaurantId, role])
  @@map("staff_users")
}

model DiningTable {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  name         String
  capacity     Int      @db.SmallInt
  qrToken      String   @unique @map("qr_token")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([branchId, name])
  @@map("dining_tables")
}

model MenuCategory {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  slug         String
  name         String
  imageUrl     String?  @map("image_url")
  sortOrder    Int      @default(0) @map("sort_order") @db.SmallInt
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([restaurantId, slug])
  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  slug         String
  name         String
  description  String?
  priceMinor   Int      @map("price_minor")
  halfPriceMinor Int?   @map("half_price_minor")
  isVegetarian Boolean  @map("is_vegetarian")
  spiceLevel   Int      @default(0) @map("spice_level") @db.SmallInt
  calories     Int?
  prepMinutes  Int?     @map("prep_minutes") @db.SmallInt
  imageUrl     String?  @map("image_url")
  tags         String[]
  allergens    String[]
  nutrition    Json?
  isAvailable  Boolean  @default(true) @map("is_available")
  ratingAvg    Decimal  @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount  Int      @default(0) @map("rating_count")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([restaurantId, slug])
  @@index([restaurantId, categoryId])
  @@map("menu_items")
}

model Promotion {
  id            String       @id @default(uuid()) @db.Uuid
  restaurantId  String       @map("restaurant_id") @db.Uuid
  name          String
  code          String?
  discountType  DiscountType @map("discount_type")
  discountValue Int          @map("discount_value")
  minOrderMinor Int          @default(0) @map("min_order_minor")
  startsAt      DateTime     @map("starts_at") @db.Timestamptz
  endsAt        DateTime     @map("ends_at") @db.Timestamptz
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("promotions")
}

model Customer {
  id              String        @id @default(uuid()) @db.Uuid
  phone           String?       @unique
  customerCode    String        @unique @default(dbgenerated("('RFC-'::text || nextval('customer_code_seq'::regclass))")) @map("customer_code")
  phoneVerifiedAt DateTime?     @map("phone_verified_at") @db.Timestamptz
  name            String
  email           String?       @unique
  passwordHash    String?       @map("password_hash")
  dietary         String[]
  allergies       String?
  marketingOptIn  Boolean       @default(false) @map("marketing_opt_in")
  status          AccountStatus @default(active)
  lastLoginAt     DateTime?     @map("last_login_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("customers")
}

model RestaurantCustomer {
  restaurantId    String   @map("restaurant_id") @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  firstVisitAt    DateTime @map("first_visit_at") @db.Timestamptz
  lastVisitAt     DateTime @map("last_visit_at") @db.Timestamptz
  visitCount      Int      @default(1) @map("visit_count")
  totalSpentMinor BigInt   @default(0) @map("total_spent_minor")
  tags            String[]
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@id([restaurantId, customerId])
  @@index([restaurantId, lastVisitAt(sort: Desc)])
  @@map("restaurant_customers")
}

model GuestSession {
  id           String        @id @default(uuid()) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  branchId     String        @map("branch_id") @db.Uuid
  tableId      String?       @map("table_id") @db.Uuid
  customerId   String?       @map("customer_id") @db.Uuid
  partySize    Int?          @map("party_size") @db.SmallInt
  status       SessionStatus @default(active)
  startedAt    DateTime      @default(now()) @map("started_at") @db.Timestamptz
  endedAt      DateTime?     @map("ended_at") @db.Timestamptz
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([restaurantId, startedAt(sort: Desc)])
  @@map("guest_sessions")
}

// Partitioned by month on created_at; the partition key is part of the primary key.
model Order {
  id                 String      @default(uuid()) @db.Uuid
  restaurantId       String      @map("restaurant_id") @db.Uuid
  branchId           String      @map("branch_id") @db.Uuid
  tableId            String?     @map("table_id") @db.Uuid
  sessionId          String?     @map("session_id") @db.Uuid
  customerId         String?     @map("customer_id") @db.Uuid
  promotionId        String?     @map("promotion_id") @db.Uuid
  orderNumber        Int         @map("order_number")
  orderType          OrderType   @default(dine_in) @map("order_type")
  status             OrderStatus @default(new)
  subtotalMinor      Int         @map("subtotal_minor")
  taxMinor           Int         @default(0) @map("tax_minor")
  serviceChargeMinor Int         @default(0) @map("service_charge_minor")
  discountMinor      Int         @default(0) @map("discount_minor")
  totalMinor         Int         @map("total_minor")
  notes              String?
  readyAt            DateTime?   @map("ready_at") @db.Timestamptz
  servedAt           DateTime?   @map("served_at") @db.Timestamptz
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@id([id, createdAt])
  @@index([restaurantId, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id             String   @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  restaurantId   String   @map("restaurant_id") @db.Uuid
  menuItemId     String   @map("menu_item_id") @db.Uuid
  nameSnapshot   String   @map("name_snapshot")
  unitPriceMinor Int      @map("unit_price_minor")
  quantity       Int      @db.SmallInt
  lineTotalMinor Int      @map("line_total_minor")
  portion        String?
  notes          String?
  createdAt      DateTime @map("created_at") @db.Timestamptz

  @@id([id, createdAt])
  @@index([orderId, createdAt])
  @@map("order_items")
}

model Payment {
  id             String        @default(uuid()) @db.Uuid
  restaurantId   String        @map("restaurant_id") @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  orderCreatedAt DateTime      @map("order_created_at") @db.Timestamptz
  method         PaymentMethod
  status         PaymentStatus @default(pending)
  amountMinor    Int           @map("amount_minor")
  providerRef    String?       @map("provider_ref")
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@id([id, createdAt])
  @@index([orderId, orderCreatedAt])
  @@map("payments")
}

model Feedback {
  id              String    @default(uuid()) @db.Uuid
  restaurantId    String    @map("restaurant_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  tableId         String?   @map("table_id") @db.Uuid
  customerId      String?   @map("customer_id") @db.Uuid
  orderId         String?   @map("order_id") @db.Uuid
  orderCreatedAt  DateTime? @map("order_created_at") @db.Timestamptz
  overallRating   Int       @map("overall_rating") @db.SmallInt
  serviceRating   Int       @map("service_rating") @db.SmallInt
  ambienceRating  Int       @map("ambience_rating") @db.SmallInt
  valueRating     Int       @map("value_rating") @db.SmallInt
  wouldRecommend  Boolean   @map("would_recommend")
  topics          String[]
  suggestion      String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@id([id, createdAt])
  @@index([restaurantId, createdAt(sort: Desc)])
  @@map("feedback")
}

model DishRating {
  id           String   @default(uuid()) @db.Uuid
  feedbackId   String   @map("feedback_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  menuItemId   String   @map("menu_item_id") @db.Uuid
  rating       Int      @db.SmallInt
  note         String?
  createdAt    DateTime @map("created_at") @db.Timestamptz

  @@id([id, createdAt])
  @@index([restaurantId, menuItemId, createdAt(sort: Desc)])
  @@map("dish_ratings")
}

model AnalyticsEvent {
  id           BigInt   @default(autoincrement())
  restaurantId String   @map("restaurant_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  sessionId    String?  @map("session_id") @db.Uuid
  customerId   String?  @map("customer_id") @db.Uuid
  eventType    String   @map("event_type")
  properties   Json     @default("{}")
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@id([id, occurredAt])
  @@index([restaurantId, eventType, occurredAt(sort: Desc)])
  @@map("analytics_events")
}

model RestaurantDailyStat {
  restaurantId    String   @map("restaurant_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  statDate        DateTime @map("stat_date") @db.Date
  ordersCount     Int      @default(0) @map("orders_count")
  revenueMinor    BigInt   @default(0) @map("revenue_minor")
  uniqueCustomers Int      @default(0) @map("unique_customers")
  newCustomers    Int      @default(0) @map("new_customers")
  feedbackCount   Int      @default(0) @map("feedback_count")
  ratingAvg       Decimal? @map("rating_avg") @db.Decimal(3, 2)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@id([restaurantId, branchId, statDate])
  @@map("restaurant_daily_stats")
}

model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  identifier String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0) @db.SmallInt
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([identifier, createdAt(sort: Desc)])
  @@map("otp_codes")
}

model CustomerDishHistory {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  customerCode   String   @map("customer_code")
  restaurantId   String   @map("restaurant_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  sessionId      String?  @map("session_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  orderItemId    String   @unique @map("order_item_id") @db.Uuid
  orderNumber    Int      @map("order_number")
  tableName      String?  @map("table_name")
  menuItemId     String   @map("menu_item_id") @db.Uuid
  dishName       String   @map("dish_name")
  portion        String?
  quantity       Int      @db.SmallInt
  unitPriceMinor Int      @map("unit_price_minor")
  lineTotalMinor Int      @map("line_total_minor")
  orderedAt      DateTime @map("ordered_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([restaurantId, customerId, orderedAt(sort: Desc)])
  @@map("customer_dish_history")
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_settings")
}
